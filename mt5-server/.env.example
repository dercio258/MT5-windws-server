# Configurações do TorexJournal MT5 Worker

# URL do Backend Linux (NestJS)
BACKEND_URL=http://localhost:3000
WORKER_ID=win-worker-01
WORKER_KEY=secret_worker_key_change_me

# Intervalos operacionais (em segundos)
POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=15
SYNC_INTERVAL_SECONDS=10

# Capacidade e Gerenciamento de Contas
MAX_ACCOUNTS=10
MT5_DEFAULT_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Diretórios Locais
INSTANCES_DIR=./instances
DATA_DIR=./data
LOG_LEVEL=INFO
