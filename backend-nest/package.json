{
    "name": "trading-cossa-backend-nest",
    "version": "0.0.1",
    "description": "Professional Trading Backend",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
        "migrate": "node scripts/run_migrations.js",
        "migration:generate": "npm run typeorm -- -d ./src/data-source.ts migration:generate",
        "migration:run": "npm run typeorm -- -d ./src/data-source.ts migration:run",
        "migration:run:prod": "typeorm migration:run -d ./dist/data-source.js",
        "migration:revert": "npm run typeorm -- -d ./src/data-source.ts migration:revert"
    },
    "dependencies": {
        "@clickhouse/client": "^1.23.0",
        "@fastify/multipart": "^8.3.1",
        "@fastify/static": "^7.0.4",
        "@hapi/boom": "^10.0.1",
        "@mathieuc/tradingview": "^3.5.2",
        "@nestjs-modules/mailer": "^2.0.2",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/bull": "^11.0.4",
        "@nestjs/cache-manager": "^3.1.0",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.0.0",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/microservices": "^10.4.22",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/platform-fastify": "^10.4.22",
        "@fastify/multipart": "^8.3.1",
        "@fastify/static": "^7.0.4",
        "@clickhouse/client": "^1.23.0",
        "@nestjs/platform-socket.io": "^10.4.22",
        "@nestjs/schedule": "^6.1.1",
        "@nestjs/serve-static": "^4.0.0",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^10.0.1",
        "@nestjs/websockets": "^10.4.22",
